# Copiez ce fichier vers .env puis remplacez TOUTES les valeurs sensibles :
#   cp .env.example .env

# --- Base Neon (deux URLs pointant sur la MÊME branche) ---
# 1) URL JDBC utilisée par WildFly (ajoutez bien ?sslmode=require).
ECHEAN_DB_URL="jdbc:postgresql://ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require"

# 2) URI psql utilisée par scripts/init-db.sh et l'export (mot de passe inclus).
ECHEAN_PSQL_URL="postgresql://postgres:CHANGEZ_MOI@ep-xxxxxx.region.aws.neon.tech/neondb?sslmode=require"

# Identifiants repris par la datasource WildFly (les mêmes que dans l'URI ci-dessus).
ECHEAN_DB_USER="postgres"
ECHEAN_DB_PASSWORD="5379"

# --- Compte administrateur initial (uniquement si la base est vide) ---
ECHEAN_BOOTSTRAP_ADMIN_NAME="Administrateur initial"
ECHEAN_BOOTSTRAP_ADMIN_EMAIL="admin@votre-domaine.com"
ECHEAN_BOOTSTRAP_ADMIN_PASSWORD="CHANGEZ_MOI_12_CARACTERES_MINIMUM"

# --- Nom de domaine (profil Caddy / HTTPS) ---
ECHEAN_DOMAIN="echean.votre-domaine.com"

# --- E-mail sortant (facultatif : sans ces valeurs, les messages restent en file) ---
ECHEAN_SMTP_HOST=""
ECHEAN_SMTP_PORT=587
ECHEAN_SMTP_USER=""
ECHEAN_SMTP_PASSWORD=""
ECHEAN_SMTP_FROM=""
