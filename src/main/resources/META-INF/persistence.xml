<?xml version="1.0" encoding="UTF-8"?>
<persistence version="3.2" xmlns="https://jakarta.ee/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd">
  <persistence-unit name="my_persistence_unit" transaction-type="JTA">
    <jta-data-source>java:jboss/datasources/echeanDS</jta-data-source>
    <properties>
      <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
      <!-- Cache Hibernate de 2e niveau désactivé : l'application ne l'utilise
           pas ; le sous-système Infinispan est retiré du profil allégé
           (docker/wildfly/configure.cli). -->
      <property name="hibernate.cache.use_second_level_cache" value="false"/>
      <property name="hibernate.cache.use_query_cache" value="false"/>
    </properties>
  </persistence-unit>
</persistence>
